# Nado Environment Configuration
# Set to 'testnet' or 'mainnet'
NEXT_PUBLIC_NADO_ENV=testnet

# Ink network configurations (Nado runs on Kraken's Ink Layer 2 network)
# Sepolia testnet Chain ID is 57073
NEXT_PUBLIC_NADO_CHAIN_ID=57073

# Nado Endpoint Contract Address (used for on-chain collateral settlement and EIP-712 domain verification)
NEXT_PUBLIC_NADO_ENDPOINT_CONTRACT=0x05ec92D78ED421f3D3Ada77FFdE167106565974E
NEXT_PUBLIC_NADO_USDC_CONTRACT=0x0200C29006150606B650577BBE7B6248F58470c1
